# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://ivorra-interiors.vercel.app

# Optional: send enquiries by email through Resend (https://resend.com)
# Without these, forms still validate and succeed (demo mode).
RESEND_API_KEY=
# Inbox that receives contact and consultation requests
ENQUIRY_TO_EMAIL=
# Verified sender, e.g. "Ivorra Interiors <studio@yourdomain.com>"
ENQUIRY_FROM_EMAIL=
